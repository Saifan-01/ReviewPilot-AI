# ReviewPilot AI Environment Configuration
# Copy this file to .env and populate with your AWS credentials if testing live Amazon Bedrock models.

# AWS Credentials (optional for local testing; simulated reviewer will run if absent)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Model Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Strands Decider 2B Local Server Configuration
STRANDS_DECIDER_URL=http://127.0.0.1:8000

# Policy Decision Confidence Safety Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.80
